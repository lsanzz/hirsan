---
// Abertura do site: logo sobre o site desfocado, que depois se dissolve.
// Só aparece quando o script do <head> põe a classe "intro-on" no <html>:
// sem JavaScript ou com "reduzir movimento" ligado, não aparece.
import Logo from './Logo.astro';
---
<div class="intro" aria-hidden="true">
  <div class="intro__inner">
    <Logo height={64} class="intro__logo" />
  </div>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('.intro');
  if (intro && document.documentElement.classList.contains('intro-on')) {
    const done = () => intro.remove();
    intro.addEventListener('animationend', (e) => { if (e.animationName.includes('introOut')) done(); });
    window.setTimeout(done, 3200); // garantia, caso o evento não chegue
  } else {
    intro?.remove();
  }
</script>

<style>
  .intro { display: none; }

  :global(html.intro-on) .intro {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.62);
    -webkit-backdrop-filter: blur(22px) saturate(115%);
    backdrop-filter: blur(22px) saturate(115%);
    animation: introOut 0.75s var(--ease-out) 1.6s forwards;
  }

  .intro__inner { display: grid; justify-items: center; gap: 22px; }

  /* Wordmark: revela da esquerda para a direita, saindo do desfoque */
  .intro :global(.intro__logo) {
    animation:
      introReveal 0.9s var(--ease-out) 0.15s both,
      introLogoOut 0.6s var(--ease-out) 1.55s forwards;
  }
  /* O ponto de "hirsan ." entra por último, com um leve quique */
  .intro :global(.intro__logo circle) {
    transform-box: fill-box; transform-origin: center;
    animation: introDot 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.85s both;
  }
  @keyframes introReveal {
    from { clip-path: inset(0 100% 0 0); filter: blur(10px); opacity: 0; transform: translateY(6px); }
    to   { clip-path: inset(0 0 0 0);    filter: blur(0);    opacity: 1; transform: none; }
  }
  @keyframes introDot {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  @keyframes introLogoOut {
    to { opacity: 0; transform: scale(1.06); filter: blur(6px); }
  }
  @keyframes introOut {
    to {
      opacity: 0;
      -webkit-backdrop-filter: blur(0) saturate(100%);
      backdrop-filter: blur(0) saturate(100%);
      visibility: hidden;
    }
  }

  @media (max-width: 640px) {
    .intro :global(.intro__logo) { --logo-h: 46px !important; }
  }
</style>
